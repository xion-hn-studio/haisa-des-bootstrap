# CPython 交叉编译到 aarch64-linux-android 的 config.site
# 这些是 autoconf 无法在交叉编译中通过运行测试程序确定的变量

# /dev/ptmx 和 /dev/ptc 存在性（cross-compile 无法运行测试程序）
ac_cv_file__dev_ptmx=yes
ac_cv_file__dev_ptc=no

# getaddrinfo 非缺陷版本（否则禁用 IPv6 socket 支持）
ac_cv_buggy_getaddrinfo=no

# 双精度浮点小端序（aarch64 确定值）
ac_cv_little_endian_double=yes

# POSIX 信号量（Bionic API 21+ 提供，cross-compile 无法运行测试）
ac_cv_posix_semaphores_enabled=yes
ac_cv_func_sem_open=yes
ac_cv_func_sem_timedwait=yes
ac_cv_func_sem_getvalue=yes
ac_cv_func_sem_unlink=yes

# POSIX 共享内存
# Bionic 头文件 <sys/mman.h> 在交叉编译时不声明 shm_open/shm_unlink
# （__INTRODUCED_IN 宏在 cross-build 下可见性受限），强行声明 yes 会导致
# Modules/_multiprocessing/posixshmem.c 编译报 "undeclared function"。
# 设为 no 跳过 posixshmem 扩展，核心 multiprocessing 仍可走 pipe/fork。
ac_cv_func_shm_open=no
ac_cv_func_shm_unlink=no

# tzset 可用
ac_cv_working_tzset=yes

# faccessat 的 AT_EACCESS 标志在 Bionic 中未定义，禁用避免 os.access 异常
ac_cv_func_faccessat=no
